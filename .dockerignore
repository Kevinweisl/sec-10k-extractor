# Keep image small + reproducible. None of these belong in the runtime container.
.git
.github
.venv
venv
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
**/.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
dist
build
*.egg-info

# Local-only material; not needed at runtime
prompts
tests
scripts
docs
tasks

# IDE / OS noise
.vscode
.idea
.DS_Store

# edgartools runtime cache; container will rebuild it on demand
data

