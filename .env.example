# Required for production. SEC EDGAR rejects requests without a User-Agent
# identifying the requester. Format: "Your Name your.email@domain".
SEC_USER_AGENT="Your Name you@example.com"

# Per-IP rate limit on /extract. 6 / minute / IP keeps us well under SEC's
# 10 req/sec ceiling under full saturation. Override only if you know what
# you're doing.
EXTRACT_RPM=6

# Hard ceiling on a single live extraction in seconds. Modern multi-document
# 10-Ks (Berkshire-class) measured ~3 minutes in our silver eval; we cap at
# 60 sec so a hung request never holds a worker hostage. Use the demo cache
# for slow filings instead.
EXTRACT_TIMEOUT_S=60

# Phase 2 LLM augmentation is NOT exposed via the public HTTP server. These
# keys are only consulted by the offline silver/gold runners and are
# optional for the FastAPI app.
# NIM_BASE_URL_NEMOTRON=https://integrate.api.nvidia.com/v1
# NIM_BASE_URL_MISTRAL=https://integrate.api.nvidia.com/v1
# NIM_BASE_URL_QWEN=https://integrate.api.nvidia.com/v1
# NIM_API_KEY_NEMOTRON=nvapi-...
# NIM_API_KEY_MISTRAL=nvapi-...
# NIM_API_KEY_QWEN=nvapi-...
